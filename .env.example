# Copy to .env and edit. All values are optional except where noted for production.

# Database password (change for production).
POSTGRES_PASSWORD=change-me

# Public URL agents and install scripts use to reach this server, e.g. https://track.example.com
PUBLIC_URL=

# First admin, created on first start only if no admin exists (password >= 8 chars).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ORG_NAME=

# Where /downloads/<file> redirects when the file is not in DATA_DIR/downloads,
# e.g. https://github.com/OWNER/worklens/releases/latest/download
GITHUB_RELEASES_URL=
# Override the release base injected into install scripts (default: ${PUBLIC_URL}/downloads).
RELEASE_BASE=

# Host interface the server port binds to (127.0.0.1 when behind a local reverse proxy).
SERVER_BIND=0.0.0.0

# Optional comma-separated CORS origins for the API.
CORS_ORIGIN=
