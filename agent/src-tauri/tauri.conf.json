{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openv360",
  "mainBinaryName": "openv360-agent",
  "version": "0.1.3",
  "identifier": "org.openv360.agent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "openv360",
        "width": 420,
        "height": 720,
        "resizable": true,
        "visible": false,
        "center": true,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Open-source time and activity tracker",
    "longDescription": "openv360 agent: tracks work time, active apps and periodic screenshots, and syncs them to your organisation's self-hosted openv360 server. Tracking is always visible in the system tray.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
