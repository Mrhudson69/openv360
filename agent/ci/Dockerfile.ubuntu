# Builds and tests the agent on Ubuntu (used locally and in CI to verify Linux support).
ARG UBUNTU=24.04
FROM ubuntu:${UBUNTU}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates build-essential pkg-config file \
      libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev \
      libxdo-dev libssl-dev libdbus-1-dev libpipewire-0.3-dev libgbm-dev libxcb1-dev \
      libxrandr-dev libegl1-mesa-dev clang \
    && rm -rf /var/lib/apt/lists/*
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH=/root/.cargo/bin:$PATH
WORKDIR /src
